{
  "policies": [
    {
      "name": "monetization-inbound",
      "policyType": "monetization-inbound",
      "handler": {
        "export": "MonetizationInboundPolicy",
        "module": "$import(@zuplo/runtime)",
        "options": {
          "cacheTtlSeconds": 60,
          "meters": {
            "api_requests": 1
          }
        }
      }
    }
  ],
  "corsPolicies": [
    {
      "name": "developer-portal",
      "allowedOrigins": [
        "$env(DEVELOPER_PORTAL_ORIGIN)"
      ],
      "allowedMethods": [
        "GET",
        "OPTIONS"
      ],
      "allowedHeaders": [
        "authorization",
        "content-type"
      ],
      "maxAge": 600
    }
  ]
}
